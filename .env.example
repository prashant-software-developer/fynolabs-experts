# Expert Hub settings. Copy to .env.local for local work; set the same names on Vercel.
# Leave DATABASE_URL empty locally to use the built-in demo database (PGlite in .data/).

# Neon Postgres connection string (production: the "Engine" project; test on a branch first).
DATABASE_URL=

# Auth.js secret: any long random string (run: npx auth secret, or openssl rand -base64 32).
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may sign in: verified Google accounts ending in @ALLOWED_DOMAIN ...
ALLOWED_DOMAIN=xocket.sh
# ... plus these exact addresses (comma-separated), e.g. a contractor's Gmail.
ALLOWED_EMAILS=

# Roles (Settings > Team & access). These addresses are always admins: the first admin, and a way back in.
ADMIN_EMAILS=
# Role for @ALLOWED_DOMAIN people who aren't on the team list yet: admin, recruiter, pod_lead, finance or viewer.
DEFAULT_ROLE=viewer
# Local development only (auto sign-in without Google keys): the role you start as (default admin).
# DEV_ROLE=admin

# Only for `npm run db:migrate` / `npm run import:jobs` against a real database.
# CONFIRM_DB=yes
