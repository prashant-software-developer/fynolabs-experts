# Expert Hub settings. Copy to .env.local for local work; set the same names on Vercel.
# Leave DATABASE_URL empty locally to use the built-in demo database (PGlite in .data/).

# The app's OWN Neon database (Neon project "expert-hub", its main branch: the one real environment;
# see docs/DEPLOY.md). Set here, `npm run dev` and Start Expert Hub.bat use the real database too
# (a red bar says so). The app's tables live in the schema "hub"; the copy of Engine in "engine_copy".
DATABASE_URL=

# Optional, only for `npm run copy:engine` (Copy experts from Engine.bat): Engine, the old jobs
# site's database, read only. Usually left empty: the launcher reads JOBS_DATABASE_URL from
# ..\Jobs - FynoLabs\.env instead (--source-env / --source-key).
ENGINE_DATABASE_URL=

# Optional, only for `npm run import:jobs` (and the Import page): the OLD jobs site's database
# (the shared "Engine" project), read only. Leave empty if the jobs-site tables are in DATABASE_URL.
JOBS_DATABASE_URL=

# Auth.js secret: any long random string (run: npx auth secret, or openssl rand -base64 32).
AUTH_SECRET=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials). Used by the team AND experts.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: "Sign in with LinkedIn" for experts (LinkedIn app with "Sign In with LinkedIn using OpenID Connect").
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Optional: email (Resend). Turns on email sign-in links for experts and invite emails from a job's
# Matches tab. Leave empty and nothing is ever emailed.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. FynoLabs <hello@fynolabs.si>
EMAIL_FROM=

# Who counts as the TEAM (everyone else who signs in is an expert and gets the expert portal):
# verified accounts ending in @ALLOWED_DOMAIN ...
ALLOWED_DOMAIN=xocket.sh
# ... plus these exact addresses (comma-separated), e.g. a contractor's Gmail (viewer until given a role) ...
ALLOWED_EMAILS=
# ... plus anyone added in Admin > Settings > Team & access.

# Roles. These addresses are always admins: the first admin, and a way back in.
ADMIN_EMAILS=
# Role for @ALLOWED_DOMAIN people who aren't on the team list yet: admin, recruiter, pod_lead, finance or viewer.
DEFAULT_ROLE=viewer
# Local development only (auto sign-in without Google keys): the role you start as (default admin).
# DEV_ROLE=admin

# Public site. The name shown on the job board and in job posts (default FynoLabs).
PUBLIC_SITE_NAME=FynoLabs
# The public address, for share links, Open Graph and Google Jobs, e.g. https://jobs.fynolabs.si
# (optional: without it the address of each request is used).
PUBLIC_SITE_URL=
# The contact address shown to applicants (default hello@fynolabs.si).
# PUBLIC_CONTACT_EMAIL=hello@fynolabs.si

# Only for `npm run db:migrate` / `npm run import:jobs` / `npm run copy:engine` against a real database.
# CONFIRM_DB=yes
