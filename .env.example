# Expert Hub settings. Copy to .env.local for local work; set the same names on Vercel.

# The app's database: Neon project "expert-hub", its main branch (the one environment; see
# docs/DEPLOY.md). Required: without it the app only shows a "Database not set up" page.
# The app's tables live in the schema "hub"; the copy of Engine in "engine_copy"; the copy of the
# FynoLabs admin in "fynolabs_copy".
DATABASE_URL=

# Optional, only for `npm run copy:engine` (Copy experts from Engine.bat): Engine, the old jobs
# site's database, read only. Usually left empty: the launcher reads JOBS_DATABASE_URL from
# ..\Jobs - FynoLabs\.env instead (--source-env / --source-key).
ENGINE_DATABASE_URL=

# Optional, only for `npm run import:jobs` (and the Import page): the OLD jobs site's database
# (the shared "Engine" project), read only. Leave empty if the jobs-site tables are in DATABASE_URL.
JOBS_DATABASE_URL=

# Only for `npm run sync:fynolabs` (Copy FynoLabs data.bat): the FynoLabs admin's hub-sync edge
# function and its token. The token must equal the HUB_SYNC_TOKEN secret in Lovable (Cloud -> Secrets);
# `npm run token:new` writes a fresh one into .env.local. The URL has a default.
FYNOLABS_SYNC_TOKEN=
# FYNOLABS_SYNC_URL=https://kmnlyniplnkwfkbhehei.supabase.co/functions/v1/hub-sync

# Auth.js secret: any long random string (run: npx auth secret, or openssl rand -base64 32).
# Changing it signs everyone out.
AUTH_SECRET=

# Optional: "Continue with Google" (Google Cloud Console > APIs & Services > Credentials).
# Sign-in with an email and password works without it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: "Continue with LinkedIn" (LinkedIn app with "Sign In with LinkedIn using OpenID Connect").
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Email: sign-up codes, password reset links and invite emails. Set EMAIL_FROM plus EITHER Resend
# OR an SMTP server (Resend wins when both are set). Without either, nothing is ever emailed:
# expert sign-up with a password is switched off and "Forgot password?" says to ask an admin.
# The sender, e.g. FynoLabs <hello@fynolabs.si> (on Resend: a domain verified there).
EMAIL_FROM=
# Resend (resend.com): an API key.
RESEND_API_KEY=
# SMTP, e.g. the hello@fynolabs.si mailbox on Hostinger: smtp.hostinger.com, port 465, the
# mailbox address and its password. Port 465 uses SSL; 587 uses STARTTLS (set SMTP_SECURE=false).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true

# Who counts as the TEAM (everyone else is an expert). Team logins are created in
# Admin > Settings > Team & access (or with npm run admin:create); nobody can sign up as team.
# Accounts ending in @ALLOWED_DOMAIN that sign in with Google are team too ...
ALLOWED_DOMAIN=xocket.sh
# ... plus these exact addresses (comma-separated), e.g. a contractor's Gmail (viewer until given a role).
ALLOWED_EMAILS=

# Roles. These addresses are always admins, whatever Team & access says (a way back in).
ADMIN_EMAILS=prashant@xocket.sh
# Role for @ALLOWED_DOMAIN people who sign in with Google but aren't on the team list yet:
# admin, recruiter, pod_lead, finance or viewer.
DEFAULT_ROLE=viewer

# Public site. The name shown on the job board and in job posts (default FynoLabs).
PUBLIC_SITE_NAME=FynoLabs
# The public address, for share links, Open Graph, Google Jobs and the links in emails (sign-up
# and password reset), e.g. https://jobs.fynolabs.si. Set it in production.
PUBLIC_SITE_URL=
# The contact address shown to applicants (default hello@fynolabs.si).
# PUBLIC_CONTACT_EMAIL=hello@fynolabs.si

# Only for `npm run db:migrate` / `npm run admin:create` / `npm run import:jobs` / `npm run copy:engine` / `npm run sync:fynolabs`.
# CONFIRM_DB=yes
